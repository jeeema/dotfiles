[core]
    editor = hx
    pager = delta

[init]
    defaultBranch = main

[color]
    ui = auto

[interactive]
    diffFilter = delta --color-only

[delta]
    # side-by-side = true
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
    theme = ayu-dark
    true-color = always
    # hyperlinks = true
    # hyperlinks-file-link-format = "zed://file/{path}:{line}"

[merge]
    conflictStyle = zdiff3
