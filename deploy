# This is a relatively heavy sequence
rust_seq() {
	local cargo_opts=()
	[[ "$verbose_flag" = 'true' ]] && cargo_opts+=('--verbose')
	[[ "$force_flag" = 'true' ]] && cargo_opts+=('--force')

	if [[ "$debug_flag" = 'true' ]]; then
		# do some tests here
		return
	fi

	ask_and_install 'Rust toolchains' '_command_exists rustup' '_install_rust_toolchains'
	rustup update

	echo '⏬ Installing Rust crates...'

	# cargo-binstall (https://github.com/cargo-bins/cargo-binstall)
	ask_and_install 'cargo-binstall' '_command_exists cargo-binstall' "curl -L --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash"
	cargo binstall "${cargo_opts[@]}" cargo-binstall

	local -r crates=(
		'bat:true'
		'Bear:true'
		'brush:false'
		'delta:true'
		'eza:true'
		'fd:true'
		'helix:true'
		'navi:true'
		'ripgrep:true'
		'sd:true'
		'starship:true'
		'tealdeer:true'
		'typst:false'
		'tinymist:false'
		'typstyle:false'
		'uv:true'
		'yazi:true'
		'zellij:true'
		'zoxide:true'
	)

	local crate nosudo
	for crate_flag in "${crates[@]}"; do
		IFS=':' read -r crate nosudo <<<"$crate_flag"
		if [[ $sudoable_flag == true || $nosudo = true ]]; then
			"_setup_${crate}"
		fi
	done

	printf '✅ COMPLETE installing Rust crates.\n\n'
}

