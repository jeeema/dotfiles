# -------- bat (https://github.com/sharkdp/bat) --------
_setup_bat() {
	echo "Entering $submodules_path/bat"
	pushd "$submodules_path/bat" >/dev/null
	cargo install --path . --locked "${cargo_opts[@]}"
	popd >/dev/null
	echo "Leaving $submodules_path/bat"

	# manpage
	\cp "$(fd bat.1 "$submodules_path"/bat/target/release/build/bat-*)" "$HOME/.cargo/share/man/man1"

	# shell completion (https://github.com/sharkdp/bat#from-cratesio
	case $shell_basename in
	bash)
		bat --completion bash >"$bash_completion_dir/bat.bash"
		;;
	zsh)
		# ensure ~/.zfunc is in your fpath
		bat --completion zsh >"$HOME/.zfunc/_bat"
		;;
	fish)
		bat --completion fish >"$XDG_CONFIG_HOME/fish/completions/bat.fish"
		;;
	*)
		echo -e "$self_name: ${FUNCNAME[0]}(): ${color_yellow}[WARN]${color_reset} Add the shell configuration for '${shell_basename}'."
		;;
	esac
	# config file
	_safe_ln_s "$dotfiles_path/bat/config" "$(bat --config-file)"
	# themes
	_safe_ln_s "$dotfiles_path/bat/themes" "$(bat --config-dir)/themes"
	bat cache --build # Update the binary cache
}

