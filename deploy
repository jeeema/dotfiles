# GitHub CLI (https://github.com/cli/cli)
_install_gh() {
	curl -fsSL -o - https://cli.github.com/packages/githubcli-archive-keyring.gpg | gpg --show-keys
	echo 'Check the key fingerprints at https://github.com/cli/cli/blob/trunk/docs/install_linux.md'
	read -rp 'Do you proceed? [Y/n]: ' yn
	case "$yn" in
	[Nn]*)
		echo 'Cancel installing GitHub CLI.'
		exit 1
		;;
	*)
		# https://github.com/cli/cli/blob/trunk/docs/install_linux.md#debian
		sudo mkdir -p -m 755 /etc/apt/keyrings
		out=$(mktemp) && wget -nv -O"$out" https://cli.github.com/packages/githubcli-archive-keyring.gpg
		cat "$out" | sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg >/dev/null
		sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
		sudo mkdir -p -m 755 /etc/apt/sources.list.d
		echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | sudo tee /etc/apt/sources.list.d/github-cli.list >/dev/null
		sudo apt update
		sudo apt install -y "${apt_opts[@]}" gh
		;;
	esac
}

# Intel oneAPI Toolkit
# NOTE: Only Ubuntu LTS is officially supported, so do not upgrade Ubuntu carelessly
# https://www.intel.com/content/www/us/en/developer/tools/oneapi/oneapi-toolkit-download.html
_install_intel_oneapi_toolkit() {
	# download the key to system keyring
	wget -O- https://apt.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB |
		gpg --dearmor | sudo tee /usr/share/keyrings/oneapi-archive-keyring.gpg >/dev/null

	# add signed entry to apt sources and configure the APT client to use Intel repository:
	echo 'deb [signed-by=/usr/share/keyrings/oneapi-archive-keyring.gpg] https://apt.repos.intel.com/oneapi all main' | sudo tee /etc/apt/sources.list.d/oneAPI.list
	sudo apt update
	sudo apt install "${apt_opts[@]}" intel-oneapi-toolkit
}

apt_seq() {
	if [[ $sudoable_flag = false ]]; then
		return
	fi

	local apt_opts=()
	[[ "$verbose_flag" = 'true' ]] && apt_opts+=('--show-versions')

	if [[ "$debug_flag" = 'true' ]]; then
		# do some tests here
		return
	fi

	read -rp "Do you want to refresh APT packges? [Y/n]: " yn
	case "$yn" in
	[Nn]*)
		# skip if $yn starts with N or n
		echo "Skip refreshing APT packges."
		;;
	*)
		sudo apt update
		sudo apt upgrade
		sudo apt autoremove --purge
		sudo apt autoclean
		printf '✅ COMPLETE refreshing APT packages.\n\n'
		;;
	esac

	echo '⏬ Installing APT packages...'
	local -r apt_packages=(
		'bash-completion'
		'build-essential'
		'clang'
		'clang-format'
		'clang-tidy'
		'clangd'
		'cmake'
		'curl'
		'direnv'
		'enscript'
		'ffmpeg'
		'gawk'
		'gawk-doc'
		'gdb-doc'
		'gfortran'
		'gnupg'
		'gnuplot'
		'graphviz'
		'htop'
		'hwloc'
		'imagemagick'
		'iputils-tracepath'
		'jq'
		'language-pack-ja'
		'libblas-dev'
		'liblapack-dev'
		'liblapacke-dev'
		'libnotify-bin'
		'libomp-dev'
		'libpcre2-dev'
		'libsixel-bin'
		'libssl-dev'
		'linux-tools-generic'
		'manpages-ja'
		'manpages-ja-dev'
		'parallel'
		'pcre2-utils'
		'pkg-config'
		'rename'
		'socat'
		'tree'
		'valgrind'
		'wget'
		'wl-clipboard'
		'whois'
		'zip'
	)

	for pkg in "${apt_packages[@]}"; do
		if ! dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'ok installed'; then
			echo "⏬ Installing $pkg..."
			sudo apt install -y "${apt_opts[@]}" "$pkg"
		fi
	done

	# TeX Live
	ask_and_install 'TeX Live' "dpkg-query -W -f='\${Status}' texlive-full 2>/dev/null | grep -q 'ok installed'" "sudo apt install -y ${apt_opts[*]} 'texlive*'"

	ask_and_install 'GitHub CLI' '_command_exists gh' '_install_gh'

	local vendor_id
	vendor_id="$(grep -m 1 -oP '^vendor_id\s:\s\K.*' /proc/cpuinfo)"
	if [[ ${vendor_id:-} = 'GenuineIntel' ]]; then
		ask_and_install 'Intel oneAPI Toolkit' "dpkg-query -W -f='\${Status}' intel-oneapi-toolkit 2>/dev/null | grep -q 'ok installed'" '_install_intel_oneapi_toolkit'
	fi

	printf '✅ COMPLETE installing APT packages.\n\n'
}

