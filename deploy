	[[ -f $HOME/.ghcup/env ]] && . "$HOME/.ghcup/env" # ghcup-env
}

# This is a relatively heavy sequence
haskell_seq() {
	# TODO: Add cabal_opts & stack_opts
	local ghcup_opts=()
	[[ "$verbose_flag" = 'true' ]] && ghcup_opts+=('--verbose')
	[[ "$force_flag" = 'true' ]] && ghcup_opts+=('--force')

	if [[ "$debug_flag" = 'true' ]]; then
		# do some tests here
		return
	fi

	ask_and_install 'Haskell toolchains' '_command_exists ghcup' '_install_haskell_toolchains'
	ghcup upgrade "${ghcup_opts[@]}"

	# Upgrade to latest versions, and set them to defaults
	ghcup install "${ghcup_opts[@]}" ghc latest --set
	ghcup install "${ghcup_opts[@]}" hls latest --set
	ghcup install "${ghcup_opts[@]}" cabal latest --set
	ghcup install "${ghcup_opts[@]}" stack latest --set

	# Update package indices
	cabal update
	stack update

	echo '⏬ Installing Haskell packages...'
	# ShellCheck (https://www.shellcheck.net/)
	cabal install ShellCheck --overwrite-policy=always # https://github.com/koalaman/shellcheck#installing

	printf '✅ COMPLETE installing Haskell packages.\n\n'
}

