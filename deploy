# TODO: Add path normalization
# creates a symbolic link in a safe way
_safe_ln_s() {
	# executes only if linked destination($2) is neither present nor a symblic link
	if [[ ! -e $2 ]] && [[ ! -L $2 ]]; then
		mkdir -p "$(dirname "$2")"
		echo "ln -s $1 $2"
		ln -s "$1" "$2"
	fi
}

# Interactive installation helper
ask_and_install() {
	local -r tool_name="$1"
	local -r check_cond="$2"
	local -r install_script="$3"

	if eval "$check_cond"; then
		echo "✅ $tool_name is already installed."
	else
		read -rp "$tool_name is not installed. Do you want to install it? [Y/n]: " yn
		case "$yn" in
		[Nn]*)
			# skip if $yn starts with N or n
			echo "Skip installing $tool_name."
			;;
		*)
			# run installation otherwise (Enter, Y, y)
			echo "⏬ Installing $tool_name..."
			eval "$install_script"
			echo -e "✅ COMPLETE installing $tool_name.\n"
			;;
		esac
	fi
}

