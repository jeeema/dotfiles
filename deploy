}

go_seq() {
	local go_opts=()
	[[ "$verbose_flag" = 'true' ]] && go_opts+=('-v' '-x')
	[[ "$force_flag" = 'true' ]] && go_opts+=('-a')

	if [[ "$debug_flag" = 'true' ]]; then
		# do some tests here
		return
	fi

	# TODO
	# https://go.dev/doc/install
	if _command_exists go; then
		local installed_go_version
		installed_go_version="$(go version | cut -d' ' -f3 | sed 's/^go//')"
		if [[ $installed_go_version = "$go_version" ]]; then
			echo "✅ Go $go_version is already installed."
		else
			read -rp "Version $go_version is specified, but it appears that version $installed_go_version is already installed. Do you want to remove the existing version $installed_go_version and install version $go_version? [Y/n]: " yn
			case "$yn" in
			[Nn]*)
				echo 'Skip installing Go.'
				;;
			*)
				echo "❗ Removing Go $installed_go_version..."
				sudo rm -rf '/usr/local/go'
				echo "✅ COMPLETE removing Go $installed_go_version."
				echo "⏬ Installing Go $go_version..."
				_install_go
				echo -e "✅ COMPLETE installing Go $go_version.\n"
				;;
			esac
		fi
	else
		read -rp 'Go is not installed. Do you want to install it? [Y/n]: ' yn
		case "$yn" in
		[Nn]*)
			echo 'Skip installing Go.'
			;;
		*)
			echo "⏬ Installing Go $go_version..."
			_install_go
			echo -e "✅ COMPLETE installing Go $go_version.\n"
			;;
		esac
	fi

	echo '⏬ Installing Go tools...'

	_setup_fzf
	_setup_lazygit
	_setup_shfmt

	printf '✅ COMPLETE installing Go tools.\n\n'
}

