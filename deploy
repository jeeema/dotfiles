# ====================================================================

help() {
	cat <<EOF
Usage: $(basename "$0") [OPTIONS...] [TARGETS...]

Options:
  -d, --debug    Enable debug mode
  -v, --verbose  Enable verbose output
  -f, --force    Force installation (override existing installations)
  -h, --help     Show this help message

Targets:
  --apt          Install & update APT packages
  --rust         Install & update Rust toolchain and crates
  --go           Install & update Go and tools
  --haskell      Install & update Haskell toolchain and packages
  --nodejs       Install & update Node.js and npm packages
  --misc         Install & update ble.sh, compiledb

By default, all targets are executed. If one or more target flags are
specified, only those explicitly selected targets will be run.
EOF
}

parse_args() {
	local parsed_args

	# -o dvfh: short options (-d, -v, -f, -h)
	# -l debug,verbose,force,help: long options
	if ! parsed_args=$(getopt -n "$0" -o dvfh -l debug,verbose,force,help,apt,rust,go,haskell,nodejs,misc -- "$@"); then
		# Simply exit because getopt prints an error when an invalid options is passed
		exit 1
	fi

	eval set -- "$parsed_args"

	while true; do
		case "$1" in
		-d | --debug)
			debug_flag='true'
			echo '⚒️ DEBUG flag specified'
			shift
			;;
		-v | --verbose)
			verbose_flag='true'
			echo '📢 VERBOSE flag specified'
			set -x
			shift
			;;
		-f | --force)
			force_flag='true'
			echo '❗ FORCE flag specified (existing installations will be overridden)'
			shift
			;;
		-h | --help)
			help
			exit 0
			;;
		--apt)
			do_apt_seq_flag='true'
			is_any_opt_flag='true'
			shift
			;;
		--rust)
			do_rust_seq_flag='true'
			is_any_opt_flag='true'
			shift
			;;
		--go)
			do_go_seq_flag='true'
			is_any_opt_flag='true'
			shift
			;;
		--haskell)
			do_haskell_seq_flag='true'
			is_any_opt_flag='true'
			shift
			;;
		--nodejs)
			do_nodejs_seq_flag='true'
			is_any_opt_flag='true'
			shift
			;;
		--misc)
			do_misc_flag='true'
			is_any_opt_flag='true'
			shift
			;;
		--)
			# End of options
			shift
			break
			;;
		*)
			echo -e "${color_red}INTERNAL ERROR: reached an unrechable pattern${color_reset}" >&2
			exit 1
			;;
		esac
	done
}

# make some directories
make_dirs() {
	mkdir -p "$XDG_CONFIG_HOME"

	mkdir -p "$HOME/.local/bin"

	# path to place user-specific bash completions
	mkdir -p "$XDG_DATA_HOME/bash-completion/completions"

	# When you want to install a new font family, put it into this directory
	# and then execute `fc-cache -fv`
	mkdir -p "$XDG_DATA_HOME/fonts" # the directory where user-specific font files will be installed

	mkdir -p "$XDG_DATA_HOME/man/man1"     # man pages directory for those commands installed to $HOME/.local/bin
	mkdir -p "$HOME/.cargo/share/man/man1" # man pages directory for the commands installed via cargo

	if [[ $sudoable_flag == true ]]; then
		mkdir -p "$HOME/bin"
		mkdir -p "$HOME/Documents"
		mkdir -p "$HOME/Downloads"
	fi
}

make_symlinks() {
	local -r src_dest_list=(
		'.bash_profile' "$HOME/.bash_profile"
		'.profile' "$HOME/.profile"
		'.bashrc' "$HOME/.bashrc"
		'.bash_aliases' "$HOME/.bash_aliases"

		'git/ignore' "$XDG_CONFIG_HOME/git/ignore"
		'.vimrc' "$HOME/.vimrc"
		'.nanorc' "$HOME/.nanorc"
		'clangd/config.yaml' "$XDG_CONFIG_HOME/clangd/config.yaml"
		'bear.yml' "$XDG_CONFIG_HOME/bear.yml"
		'pip.conf' "$XDG_CONFIG_HOME/pip/pip.conf"
		'.amrvis.defaults' "$HOME/.amrvis.defaults"
		'gnuplot/gnuplot-wxt.conf' "$XDG_CONFIG_HOME/gnuplot/gnuplot-wxt.conf"

		# 'fish/config.fish'              "$XDG_CONFIG_HOME/fish/config.fish"
		# 'fish/functions/run.fish'       "$XDG_CONFIG_HOME/fish/functions/run.fish"
		# 'fish/functions/realwhich.fish' "$XDG_CONFIG_HOME/fish/functions/realwhich.fish"
		# 'fish/functions/mkcdir.fish'    "$XDG_CONFIG_HOME/fish/functions/mkcdir.fish"
		# 'fish/functions/sedelta.fish'   "$XDG_CONFIG_HOME/fish/functions/sedelta.fish"
		# 'fish/functions/sediff.fish'    "$XDG_CONFIG_HOME/fish/functions/sediff.fish"

		# 'init.el'   "$HOME/.emacs.d/init.el"
		# 'custom.el' "$HOME/.emacs.d/custom.el"
		# 'cargo-atcoder.toml' "$XDG_CONFIG_HOME/cargo-atcoder.toml"
	)

	# Iterate the list pair by pair
	for ((i = 0; i < ${#src_dest_list[@]}; i += 2)); do
		local src="${src_dest_list[i]}"
		local dest="${src_dest_list[i + 1]}"
		_safe_ln_s "$dotfiles_path/$src" "$dest"
	done

	if [[ ${WSL_DISTRO_NAME:-} ]]; then
		_safe_ln_s '/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe' "$HOME/.local/bin/powershell.exe"
	fi
}

main() {
	parse_args "$@"

	make_dirs
	make_symlinks

	if [[ "$do_apt_seq_flag" == 'true' || "$is_any_opt_flag" == 'false' ]]; then
		apt_seq
	fi

	if [[ "$do_rust_seq_flag" == 'true' || "$is_any_opt_flag" == 'false' ]]; then
		rust_seq
	fi

	if [[ "$do_go_seq_flag" == 'true' || "$is_any_opt_flag" == 'false' ]]; then
		go_seq
	fi

	if [[ "$do_haskell_seq_flag" == 'true' || "$is_any_opt_flag" == 'false' ]]; then
		haskell_seq
	fi

	if [[ "$do_nodejs_seq_flag" == 'true' || "$is_any_opt_flag" == 'false' ]]; then
		nodejs_seq
	fi

	if [[ "$do_misc_flag" == 'true' || "$is_any_opt_flag" == 'false' ]]; then
		setup_blesh
		setup_compiledb
	fi

	if [[ "$debug_flag" = 'false' ]]; then
		printf '🎉 Deployment is successful.\n   Restart the shell, or re-source '~/.profile'.\n'
	fi
}

(return 0 2>/dev/null) || main "$@"
