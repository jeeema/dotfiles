snippet MultiSet
    #[derive(Clone)]
    struct MultiSet<K: std::cmp::Ord> {
        len: usize,
        bm: BTreeMap<K, usize>,
    }

    impl<K: std::cmp::Ord> MultiSet<K> {
        fn new() -> Self {
            Self {
                len: 0,
                bm: BTreeMap::new(),
            }
        }
        fn len(&self) -> usize {
            self.len
        }
        fn len_as_set(&self) -> usize {
            self.bm.len()
        }
        fn is_empty(&self) -> bool {
            self.len() == 0
        }
        fn multiplicity(&self, x: &K) -> usize {
            *self.bm.get(x).unwrap_or(&0)
        }
        fn contains(&self, x: &K) -> bool {
            self.multiplicity(x) > 0
        }
        fn insert(&mut self, x: K) {
            self.len += 1;
            *self.bm.entry(x).or_insert(0) += 1;
        }
        fn remove(&mut self, x: &K) -> bool {
            let n = self.multiplicity(x);
            if n > 0 {
                if n == 1 {
                    self.bm.remove(x);
                } else {
                    *self.bm.get_mut(x).unwrap() -= 1;
                }
                self.len -= 1;
                true
            } else {
                false
            }
        }
        fn first(&self) -> Option<&K> {
            self.bm.keys().next()
        }
        fn last(&self) -> Option<&K> {
            self.bm.keys().next_back()
        }
    }

    impl<K: std::cmp::Ord + Clone> MultiSet<K> {
        fn pop_first(&mut self) -> Option<K> {
            match self.first() {
                Some(x) => {
                    let x = x.clone();
                    self.remove(&x);
                    Some(x)
                }
                None => None,
            }
        }
        fn pop_last(&mut self) -> Option<K> {
            match self.last() {
                Some(x) => {
                    let x = x.clone();
                    self.remove(&x);
                    Some(x)
                }
                None => None,
            }
        }
    }

snippet RollingHash
    const B1: i64 = 1007;
    const MOD1: i64 = 1000000007;
    const B2: i64 = 2009;
    const MOD2: i64 = 1000000009;
    struct RollingHash {
        hash1: Vec<i64>,
        hash2: Vec<i64>,
        memoized_power1: Vec<i64>,
        memoized_power2: Vec<i64>,
    }
    impl RollingHash {
        fn new(s: &str) -> Self {
            let n = s.len();
            let construct_mamoized_power = |b, p| {
                (0..=n)
                    .scan(0, |acc, _| {
                        if *acc == 0 {
                            *acc = 1;
                            Some(*acc)
                        } else {
                            *acc *= b;
                            *acc %= p;
                            Some(*acc)
                        }
                    })
                    .collect_vec()
            };
            let memoized_power1 = construct_mamoized_power(B1, MOD1);
            let memoized_power2 = construct_mamoized_power(B2, MOD2);
            let construct_hash = |b, p| {
                std::iter::once(0)
                    .chain(s.bytes().map(|c| c as i64))
                    .scan(0, |acc, c| {
                        *acc = (*acc * b + c) % p;
                        Some(*acc)
                    })
                    .collect_vec()
            };
            let hash1 = construct_hash(B1, MOD1);
            let hash2 = construct_hash(B2, MOD2);
            Self {
                hash1,
                hash2,
                memoized_power1,
                memoized_power2,
            }
        }
        fn get_double_hashes(&self, l: usize, r: usize) -> (i64, i64) {
            if l >= r {
                panic!("The condition l < r must hold.");
            }
            let (l, r) = (l + 1, r + 1);
            let hash1 =
                (self.hash1[r - 1] - self.hash1[l - 1] * self.memoized_power1[r - l]).rem_euclid(MOD1);
            let hash2 =
                (self.hash2[r - 1] - self.hash2[l - 1] * self.memoized_power2[r - l]).rem_euclid(MOD2);
            (hash1, hash2)
        }
    }
snippet BinaryIndexedTree
    struct BinaryIndexedTree {
        node: Vec<i64>,
        identity: i64,
    }
    impl BinaryIndexedTree {
        fn new(v: &Vec<i64>, identity: i64) -> Self {
            let mut res = BinaryIndexedTree {
                node: vec![identity; v.len() + 1],
                identity,
            };
            for i in 0..v.len() {
                res.add(i, v[i]);
            }
            res
        }
        fn add(&mut self, mut i: usize, x: i64) {
            i += 1;
            while i < self.node.len() {
                self.node[i] += x;
                i += i & (!i + 1);
            }
        }
        fn sum(&self, mut r: usize) -> i64 {
            let mut ans = self.identity;
            while r > 0 {
                ans += self.node[r];
                r -= r & (!r + 1);
            }
            ans
        }
    }

snippet Dijkstra
    let adj = make_adjvec_undirected(n, &uv);
    let mut pq = BinaryHeap::new();
    pq.push((Reverse(0), 0));
    let mut dist = vec![INF; n];
    while let Some((Reverse(cost), u)) = pq.pop() {
        if dist[u] <= cost { continue; }
        dist[u] = cost;
        for &(v, c) in &adj[u] {
            let t = cost + c;
            if t < dist[v] {
                pq.push((Reverse(t), v));
            }
        }
    }
snippet SegmentTree
    struct SegmentTree {
        n: usize,
        node: Vec<i64>,
        identity: i64,
    }
    impl SegmentTree {
        fn new(v: &Vec<i64>, identity: i64) -> Self {
            let mut n = 1;
            while n < v.len() {
                n *= 2;
            }
            let n = n;
            let mut node = vec![identity; 2 * n - 1];
            for i in 0..v.len() {
                node[n - 1 + i] = v[i];
            }
            for i in (0..n - 1).rev() {
                node[i] = min(node[2 * i + 1], node[2 * i + 2]);
            }
            SegmentTree { n, node, identity }
        }
        fn update(&mut self, mut i: usize, x: i64) {
            i += self.n - 1;
            self.node[i] = x;
            while i > 0 {
                i = (i - 1) / 2;
                self.node[i] = min(self.node[2 * i + 1], self.node[2 * i + 2]);
            }
        }
        fn rangeq(&self, a: usize, b: usize) -> i64 {
            self.rangeq_inner(a, b, 0, 0, self.n)
        }
        fn rangeq_inner(&self, a: usize, b: usize, curr: usize, l: usize, r: usize) -> i64 {
            if r <= a || b <= l {
                self.identity
            } else if a <= l && r <= b {
                self.node[curr]
            } else {
                let vl = self.rangeq_inner(a, b, 2 * curr + 1, l, (l + r) / 2);
                let vr = self.rangeq_inner(a, b, 2 * curr + 2, (l + r) / 2, r);
                min(vl, vr)
            }
        }
    }
