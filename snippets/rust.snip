snippet make_adjvec_undirected
    fn make_adjvec_undirected(edges: &Vec<(usize, usize)>, node_num: usize) -> Vec<Vec<usize>> {
        let mut ans = vec![Vec::new(); node_num];
        for &(a, b) in edges {
            ans[a].push(b);
            ans[b].push(a);
        }
        ans
