snippet Cumsum2d
    struct Cumsum2d(Vec<Vec<i64>>);
    impl Cumsum2d {
        fn new(a: &[Vec<i64>]) -> Self {
            let (h, w) = (a.len(), a[0].len());
            let mut sum = std::iter::once(vec![0; w + 1])
                .chain(a.into_iter().map(|r| {
                    std::iter::once(0)
                        .chain(r.into_iter().cumsum())
                        .collect_vec()
                }))
                .collect_vec();
            for j in 1..=w {
                for i in 1..=h {
                    sum[i][j] += sum[i - 1][j];
                }
            }
            Self(sum)
        }
        fn get(&self, p: (usize, usize), q: (usize, usize)) -> i64 {
            let p = (p.0 + 1, p.1 + 1);
            let q = (q.0 + 1, q.1 + 1);
            self.0[q.0][q.1] - self.0[q.0][p.1 - 1] - self.0[p.0 - 1][q.1] + self.0[p.0 - 1][p.1 - 1]
        }
    }

snippet manhattan_distance
    fn manhattan_distance<T: num::Signed + Copy>(x: (T, T), y: (T, T)) -> T {
        num::abs(y.0 - x.0) + num::abs(y.1 - x.1)
    }
