    dist[0] = 0;
    queue.push_back(0);
    while let Some(curr) = queue.pop_front() {
        for &next in &adj[curr] {
            if dist[curr] + 1 < dist[next] {
                dist[next] = dist[curr] + 1;
                queue.push_back(next);
            }
        }
    }
