snippet Comb
    struct Comb {
        fact: Vec<i64>,
        finv: Vec<i64>,
        inv: Vec<i64>,
    }

    impl Comb {
        fn new(n: i64) -> Self {
            let mut fact = vec![1; (n as usize) + 1];
            let mut finv = vec![1; (n as usize) + 1];
            let mut inv = vec![1; (n as usize) + 1];
            for i in 2..=n {
                fact[i as usize] = (fact[i as usize - 1] * i) % P;
                inv[i as usize] = P - ((inv[(P % i) as usize] * (P / i)) % P);
                finv[i as usize] = (finv[i as usize - 1] * inv[i as usize]) % P;
            }
            Self { fact, finv, inv }
        }
        fn comb(&self, n: i64, k: i64) -> i64 {
            (self.fact[n as usize] * ((self.finv[k as usize] * self.finv[(n - k) as usize]) % P)) % P
        }
    }

snippet DpComb
    struct DpComb(Vec<Vec<i64>>);
    #[allow(dead_code)]
    impl DpComb {
        fn new(n: i64) -> Self {
            let n = n as usize;
            let mut cc = DpComb(vec![Vec::with_capacity(n + 1); n + 1]);
            cc.0[0].push(1);
            for i in 1..=n {
                cc.0[i].push(1);
                for j in 1..i {
                    let a = cc.0[i - 1][j - 1] + cc.0[i - 1][j];
                    cc.0[i].push(a);
                }
                cc.0[i].push(1);
            }
            cc
        }
        fn comb(&self, n: i64, k: i64) -> i64 {
            self.0[n as usize][k as usize]
        }
    }

snippet OsaK
    struct OsaK {
        size: usize,
        minimum_prime_number: Vec<i64>,
    }
    impl OsaK {
        fn new(n: i64) -> Self {
            let mut mpn = vec![n + 1; (n + 1) as usize];
            for i in 2..=n {
                let mut k = i;
                while k <= n {
                    mpn[k as usize] = min(mpn[k as usize], i);
                    k += i;
                }
            }
            OsaK {
                size: n as usize,
                minimum_prime_number: mpn,
            }
        }
        fn size(&self) -> usize {
            self.size
        }
        fn is_prime(&self, x: i64) -> bool {
            x == self.minimum_prime_number[x as usize]
        }
        fn prime_factorize(&self, x: i64) -> Vec<(i64, u32)> {
            let mut ans: Vec<(i64, u32)> = Vec::new();
            if (self.size as i64) < x {
                panic!("x is out of range! You're such a moron.");
            }
            let mut x = x;
            while x != 1 {
                let p = self.minimum_prime_number[x as usize];
                match ans.last() {
                    Some(r) if r.0 == p => {
                        let l = ans.len();
                        ans[l-1] = (p, ans[l-1].1 + 1);
                    }
                    _ => {
                        ans.push((p, 1));
                    }
                }
                x /= p;
            }
            ans
        }
    }

snippet UnionFind
    struct UnionFind(Vec<isize>);
    impl UnionFind {
        fn new(n: usize) -> UnionFind {
            UnionFind(vec![-1; n])
        }
        fn find(&mut self, x: usize) -> usize {
            if self.0[x] < 0 {
                x
            } else {
                let root = self.find(self.0[x] as usize);
                self.0[x] = root as isize;
                root
            }
        }
        fn unite(&mut self, x: usize, y: usize) {
            let (px, py) = (self.find(x), self.find(y));
            if px == py {
                return;
            }
            if self.0[px] <= self.0[py] {
                self.0[px] += self.0[py];
                self.0[py] = px as isize;
            } else {
                self.0[py] += self.0[px];
                self.0[px] = py as isize;
            }
        }
        fn size(&mut self, x: usize) -> i64 {
            let root = self.find(x) as usize;
            (-self.0[root]) as i64
        }
        fn same(&mut self, x: usize, y: usize) -> bool {
            self.find(x) == self.find(y)
        }
    }

snippet HalfOpenInterval
    enum EndPointKind {
        Closed,
        Open,
        OpenAndClosed,
    }
    struct HalfOpenInterval(BTreeMap<usize, EndPointKind>);
    impl HalfOpenInterval {
        pub fn new() -> Self {
            HalfOpenInterval(BTreeMap::new())
        }
        fn find(&self, x: usize) -> Option<(usize, usize)> {
            match self.0.range(..=x).next_back() {
                Some((&left, kind)) => match *kind {
                    EndPointKind::Closed | EndPointKind::OpenAndClosed => {
                        match self.0.range(x + 1..).next() {
                            Some((&right, _)) => Some((left, right)),
                            _ => unreachable!(),
                        }
                    }
                    EndPointKind::Open => None,
                },
                _ => None,
            }
        }
        fn add(&mut self, left: usize, right: usize) {
            if left >= right {
                panic!("the condition (left < right) was broken");
            }
            match self.0.range(..=left).next_back() {
                Some((&i, kind)) => match *kind {
                    EndPointKind::Open => {
                        if left == i {
                            self.0.insert(left, EndPointKind::OpenAndClosed);
                        } else {
                            self.0.insert(left, EndPointKind::Closed);
                        }
                    }
                    _ => {}
                },
                None => {
                    self.0.insert(left, EndPointKind::Closed);
                }
            }
            let mut list = Vec::with_capacity(self.0.len());
            for (&i, _) in self.0.range(left + 1..right) {
                list.push(i);
            }
            for i in list {
                self.0.remove(&i);
            }
            match self.0.range(right..).next() {
                Some((&i, kind)) => match *kind {
                    EndPointKind::Closed => {
                        if right == i {
                            self.0.insert(right, EndPointKind::OpenAndClosed);
                        } else {
                            self.0.insert(right, EndPointKind::Open);
                        }
                    }
                    _ => {}
                },
                None => {
                    self.0.insert(right, EndPointKind::Open);
                }
            }
        }
        fn cut(&mut self, cutpoint: usize) -> bool {
            match self.find(cutpoint) {
                Some((l, r)) => {
                    if l < cutpoint && cutpoint < r {
                        self.0.insert(cutpoint, EndPointKind::OpenAndClosed);
                    }
                    true
                }
                None => false,
            }
        }
    }
snippet comb_once
    fn comb_once(n: i64, k: i64) -> i64 {
        let k = k.min(n - k);
        let mut nu = 1;
        let mut de = 1;
        for i in 0..k {
            nu = nu * (n - i) % P;
            de = de * (i + 1) % P;
        }
        nu * integer::mod_pow(de, P - 2) % P
    }
    fn mod_pow(r: i64, mut n: i64) -> i64 {
        let mut t = 1;
        let mut s = r % P;
        while n > 0 {
            if n & 1 == 1 {
                t = t * s % P;
            }
            s = s * s % P;
            n >>= 1;
        }
        t
    }

snippet extended_euclid
    fn extended_euclid(a: i64, b: i64) -> (i64, i64) {
        if a == 0 {
            (0, 1)
        } else {
            let (x, y) = extended_euclid(b % a, a);
            (y - (b / a) * x, x)
        }
    }

snippet ModPow
    struct ModPow {
        base: i64,
        n: i64,
        pow: Vec<i64>,
    }

    impl ModPow {
        fn new(base: i64, n: i64) -> Self {
            let mut pow = vec![1; (n as usize) + 1];
            for i in 1..=n {
                pow[i as usize] = (pow[(i as usize) - 1] * base) % P;
            }
            Self { base, n, pow }
        }
        fn pow(&self, k: i64) -> i64 {
            self.pow[k as usize]
        }
    }

