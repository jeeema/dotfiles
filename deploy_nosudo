_is_latest_gh() {
	local current
	current="$(gh --version | head -n 1 | cut -d' ' -f3)"
	local latest='2.92.0'
	# [[ "$current" = "$latest" ]]
	echo "current gh: $current"
	echo "latest gh: $latest"
	return 0
}

_setup_gh() {
	:
}

install_github_cli() {
	echo '🔄️ Retrieving the latest relases of GitHub CLI...'

	# GitHubのAPIから、Linux用の .tar.gz の URL だけを抽出して配列 url_candidates に格納
	mapfile -t url_candidates < <(curl -sf https://api.github.com/repos/cli/cli/releases/latest | grep -oE "https://[^\"]+linux_[^\"]+\.tar\.gz")

	if [[ ${#url_candidates[@]} -eq 0 ]]; then
		echo -e "${color_red}error: could not find the download URL${color_reset}"
		exit 1
	fi

	# 画面表示用に、URLからファイル名（一番最後のアドレス部分）だけを抽出した配列を作る
	local filenames=()
	for url in "${url_candidates[@]}"; do
		filenames+=("$(basename "$url")")
	done

	echo ""
	echo "Choose a compressed file of GitHub CLI to download (矢印キーで選択 / Enterで決定):"
	_select_with_arrow_keys "${filenames[@]}"

	# retrieve the URL correspoinding the index chosen by a user
	local -r target_url="${url_candidates[$selected_index]}"
	local -r target_file="${filenames[$selected_index]}"

	echo "⏬ Downloading $target_url..."
	# curl -fL -O "$target_url"

	_extract_and_copy "$target_file"
	_setup_gh
}

