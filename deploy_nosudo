# creates a symbolic link in a safe way
_safe_ln_s() {
	# executes only if linked destination($2) is neither present nor a symblic link
	if [[ ! -e $2 ]] && [[ ! -L $2 ]]; then
		mkdir -p "$(dirname "$2")"
		echo "ln -s $1 $2"
		ln -s "$1" "$2"
	fi
}

