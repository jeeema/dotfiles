#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'
shopt -s inherit_errexit
shopt -s failglob

# ====================================================================
# Install precompiled GitHub Release binaries without sudo.
#
# Supported platform:
#   Linux / x86_64 / glibc or musl
#   Linux / aarch64 / glibc or musl
#
# Installed tools:
#   GitHub CLI, bat, delta, fd, ripgrep, Helix, Zellij, zoxide, direnv,
#   Starship, shfmt, Bash Language Server, ty, Ruff
#
# Nerd Fonts are intentionally left for the user to install separately.
#
# Bear is also checked, but is skipped while its upstream GitHub Releases
# provide source archives only and no precompiled binaries.
#
# Shell completion files are installed for Bash only.
# ====================================================================

readonly self_name="${0##*/}"
readonly script_version='2026.08.24'

debug_flag='false'
verbose_flag='false'
force_flag='false'
symlinks_only_flag='false'

readonly color_reset='\033[0m'
readonly color_red='\033[31m'
readonly color_yellow='\033[33m'

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

readonly bash_completion_dir="$XDG_DATA_HOME/bash-completion/completions"
readonly man1_dir="$XDG_DATA_HOME/man/man1"
readonly dotfiles_path="${DOTFILES_PATH:-$HOME/dotfiles}"

_os_raw=$(uname -s)
readonly os="${_os_raw,,}"
unset _os_raw

if [[ "$os" != 'linux' ]]; then
	printf '%b\n' "${color_red}error: only Linux is supported (detected: $os)${color_reset}" >&2
	exit 1
fi

_arch_raw=$(uname -m)
case "$_arch_raw" in
x86_64 | amd64)
	readonly arch='x86_64'
	readonly MACHINE_ARCH=''
	readonly gh_arch='amd64'
	readonly node_dist_arch='x64'
	;;
aarch64 | arm64)
	readonly arch='aarch64'
	readonly MACHINE_ARCH='aarch64-linux-gnu'
	readonly gh_arch='arm64'
	readonly node_dist_arch='arm64'
	;;
*)
	printf '%b\n' "${color_red}error: unsupported architecture ($_arch_raw)${color_reset}" >&2
	exit 1
	;;
esac
unset _arch_raw

_libc='gnu'
if command -v ldd >/dev/null 2>&1 && ldd --version 2>&1 | grep -iq 'musl'; then
	_libc='musl'
fi
readonly libc="$_libc"
unset _libc

readonly base_bin_dir="$HOME/.local/bin"
readonly install_bin_dir="$base_bin_dir${MACHINE_ARCH:+/$MACHINE_ARCH}"

tmp_root=''
gh_bin=''
SELECTED_CANDIDATE=''
SELECTION_SKIPPED='false'
INSTALLED_BINARY=''
NODE_BIN=''
NPM_BIN=''
NODE_RUNTIME_BIN_DIR=''

declare -a requested_targets=()
declare -a install_targets=()

# ========================= Helper functions =========================

_die() {
	printf '%b\n' "${color_red}error: $*${color_reset}" >&2
	exit 1
}

_warn() {
	printf '%b\n' "${color_yellow}warning: $*${color_reset}" >&2
}

_require_command() {
	command -v "$1" >/dev/null 2>&1 || _die "required command not found: $1"
}

_cleanup() {
	local status=$?

	if [[ -n "${tmp_root:-}" && -d "$tmp_root" && "$tmp_root" != '/' && "${tmp_root##*/}" == deploy_nosudo.* ]]; then
		rm -rf -- "$tmp_root"
	fi

	return "$status"
}

_make_temp_dir() {
	tmp_root=$(mktemp -d "${TMPDIR:-/tmp}/deploy_nosudo.XXXXXXXX")
	trap _cleanup EXIT
	trap 'exit 130' HUP INT TERM
}

_curl_download() {
	local -r url="$1"
	local -r output="$2"

	printf '⏬ Downloading %s\n' "${url##*/}"
	curl --fail --location --silent --show-error \
		--retry 3 --retry-delay 1 --retry-all-errors \
		--output "$output" "$url"
}

_print_version() {
	local output

	output=$("$1" --version 2>&1)
	printf '%s\n' "${output%%$'\n'*}"
}

# Sets SELECTED_CANDIDATE and SELECTION_SKIPPED. A menu is shown only when
# more than one candidate remains after filtering for the current platform.
# Passing --allow-skip adds "0) skip" to that menu.
_select_candidate() {
	local allow_skip='false'
	if [[ "${1:-}" == '--allow-skip' ]]; then
		allow_skip='true'
		shift
	fi
	local -r label="$1"
	shift
	local -a choices=("$@")
	local choice=''
	local PS3

	SELECTED_CANDIDATE=''
	SELECTION_SKIPPED='false'

	case ${#choices[@]} in
	0)
		if [[ "$allow_skip" == 'true' ]]; then
			_warn "no compatible release asset found for $label (arch=$arch, libc=$libc); skipped"
			SELECTION_SKIPPED='true'
			return 0
		fi
		_die "no compatible release asset found for $label (arch=$arch, libc=$libc)"
		;;
	1)
		SELECTED_CANDIDATE="${choices[0]}"
		;;
	*)
		[[ -t 0 ]] || _die "multiple release assets found for $label; run this script interactively"
		printf '\nSelect a release asset for %s:\n' "$label" >&2
		if [[ "$allow_skip" == 'true' ]]; then
			printf '0) skip\n' >&2
		fi
		PS3='Enter the number: '
		select choice in "${choices[@]}"; do
			if [[ "$allow_skip" == 'true' && "$REPLY" == '0' ]]; then
				SELECTION_SKIPPED='true'
				break
			fi
			if [[ -n "${choice:-}" ]]; then
				SELECTED_CANDIDATE="$choice"
				break
			fi
			printf 'Invalid selection: %s\n' "$REPLY" >&2
		done
		if [[ "$SELECTION_SKIPPED" == 'true' ]]; then
			return 0
		fi
		[[ -n "$SELECTED_CANDIDATE" ]] || _die "no release asset selected for $label"
		;;
	esac
}

_extract_archive() {
	local -r archive="$1"
	local -r output_dir="$2"

	mkdir -p "$output_dir"
	if [[ "$archive" == *.tar.xz ]]; then
		_require_command xz
	fi

	# Refuse archives containing absolute paths or parent-directory traversal.
	# Do not use grep -q here: with pipefail, its early exit could mask a
	# matching path by giving tar SIGPIPE.
	if tar -tf "$archive" | grep -E '(^/|(^|/)\.\.(/|$))' >/dev/null; then
		_die "unsafe path found in archive: ${archive##*/}"
	fi

	printf '📦 Extracting %s\n' "${archive##*/}"
	case "$archive" in
	*.tar.gz | *.tgz)
		tar -xzf "$archive" --no-same-owner --no-same-permissions -C "$output_dir"
		;;
	*.tar.xz)
		tar -xJf "$archive" --no-same-owner --no-same-permissions -C "$output_dir"
		;;
	*)
		_die "unsupported archive format: ${archive##*/}"
		;;
	esac
}

_verify_expected_sha256() {
	local -r file="$1"
	local expected="${2#sha256:}"
	local actual

	if [[ ! "$expected" =~ ^[[:xdigit:]]{64}$ ]]; then
		_die "invalid SHA-256 digest for ${file##*/}: $2"
	fi

	actual=$(sha256sum -- "$file")
	actual="${actual%% *}"

	if [[ "${actual,,}" != "${expected,,}" ]]; then
		printf 'expected: %s\nactual:   %s\n' "$expected" "$actual" >&2
		_die "SHA-256 verification failed for ${file##*/}"
	fi

	printf '🔐 SHA-256 verified: %s\n' "${file##*/}"
}

_verify_sri() {
	local -r file="$1"
	local integrity="$2"
	local node_executable="${3:-${NODE_BIN:-}}"
	local algorithm expected actual

	if [[ -z "$node_executable" ]]; then
		node_executable=$(command -v node || true)
	fi
	[[ -n "$node_executable" ]] || _die 'Node.js is required to verify Subresource Integrity'
	integrity="${integrity%% *}"
	algorithm="${integrity%%-*}"
	expected="${integrity#*-}"

	case "$algorithm" in
	sha256 | sha384 | sha512)
		;;
	*)
		_die "unsupported Subresource Integrity algorithm for ${file##*/}: $algorithm"
		;;
	esac
	[[ -n "$expected" && "$expected" != "$integrity" ]] ||
		_die "invalid Subresource Integrity value for ${file##*/}: $integrity"

	actual=$("$node_executable" -e '
const crypto = require("node:crypto");
const fs = require("node:fs");
const algorithm = process.argv[1];
const file = process.argv[2];
process.stdout.write(crypto.createHash(algorithm).update(fs.readFileSync(file)).digest("base64"));
' "$algorithm" "$file")

	if [[ "$actual" != "$expected" ]]; then
		printf 'expected: %s-%s\nactual:   %s-%s\n' "$algorithm" "$expected" "$algorithm" "$actual" >&2
		_die "Subresource Integrity verification failed for ${file##*/}"
	fi

	printf '🔐 SRI %s verified: %s\n' "$algorithm" "${file##*/}"
}

_verify_checksum_manifest() {
	local -r file="$1"
	local -r manifest="$2"
	local -r asset_name="${file##*/}"
	local matching_line=''
	local expected=''
	local -a hashes=()

	matching_line=$(grep -F -- "$asset_name" "$manifest" | head -n 1 || true)
	if [[ -n "$matching_line" ]]; then
		expected=$(grep -Eo '[[:xdigit:]]{64}' <<<"$matching_line" | head -n 1 || true)
	else
		mapfile -t hashes < <(grep -Eo '[[:xdigit:]]{64}' "$manifest" | sort -u || true)
		if ((${#hashes[@]} == 1)); then
			expected="${hashes[0]}"
		fi
	fi

	[[ -n "$expected" ]] || _die "could not find the checksum of $asset_name in ${manifest##*/}"
	_verify_expected_sha256 "$file" "$expected"
}

_install_file_atomically() {
	local -r source="$1"
	local -r destination="$2"
	local -r mode="$3"
	local staged

	[[ ! -d "$destination" ]] || _die "installation destination is a directory: $destination"
	mkdir -p "$(dirname "$destination")"
	staged=$(mktemp "$(dirname "$destination")/.${destination##*/}.XXXXXXXX")
	install -m "$mode" "$source" "$staged"
	mv -f -- "$staged" "$destination"
}

# Locates a binary in an extracted release and installs it. If an unusual
# archive contains multiple files with the same name, select is used.
_install_binary_from_tree() {
	local -r tree="$1"
	local -r binary_name="$2"
	local -a matches=()
	local -a labels=()
	local match label

	mapfile -d '' -t matches < <(find "$tree" -type f -name "$binary_name" -perm /111 -print0)
	if ((${#matches[@]} == 0)); then
		# Some third-party archives may lose executable mode bits. Fall back to
		# all same-named files and let the ambiguity check below handle them.
		mapfile -d '' -t matches < <(find "$tree" -type f -name "$binary_name" -print0)
	fi
	((${#matches[@]} > 0)) || _die "binary '$binary_name' not found in the extracted archive"

	if ((${#matches[@]} == 1)); then
		match="${matches[0]}"
	else
		for match in "${matches[@]}"; do
			labels+=("${match#"$tree"/}")
		done
		_select_candidate "$binary_name in archive" "${labels[@]}"
		match="$tree/$SELECTED_CANDIDATE"
	fi

	INSTALLED_BINARY="$install_bin_dir/$binary_name"
	_install_file_atomically "$match" "$INSTALLED_BINARY" '0755'
	printf '✅ Installed %s\n' "$INSTALLED_BINARY"
}

_install_man_pages_from_tree() {
	local -r tree="$1"
	local page

	while IFS= read -r -d '' page; do
		_install_file_atomically "$page" "$man1_dir/${page##*/}" '0644'
		printf '   man: %s\n' "$man1_dir/${page##*/}"
	done < <(find "$tree" -type f \( -name '*.1' -o -name '*.1.gz' \) -print0)
}

_find_bash_completion() {
	local -r tree="$1"
	local -r command_name="$2"
	local file

	while IFS= read -r -d '' file; do
		case "${file##*/}" in
		"$command_name.bash")
			printf '%s\n' "$file"
			return 0
			;;
		"$command_name")
			if [[ "$file" == */bash-completion/completions/* ]]; then
				printf '%s\n' "$file"
				return 0
			fi
			;;
		esac
	done < <(find "$tree" -type f \( -name "$command_name.bash" -o -name "$command_name" \) -print0)

	return 1
}

_generate_bash_completion() {
	local -r tool="$1"
	local -r binary="$2"

	case "$tool" in
	gh)
		"$binary" completion --shell bash
		;;
	bat)
		"$binary" --completion bash
		;;
	fd)
		"$binary" --gen-completions bash
		;;
	ripgrep)
		"$binary" --generate complete-bash
		;;
	starship)
		"$binary" completions bash
		;;
	*)
		return 1
		;;
	esac
}

_install_bash_completion() {
	local -r tool="$1"
	local -r tree="$2"
	local -r command_name="$3"
	local -r binary="$4"
	local -r repo="${5:-}"
	local -r tag="${6:-}"
	local destination="$bash_completion_dir/$command_name.bash"
	local completion=''
	local tagged_completion="$tmp_root/$command_name-tagged.bash"

	completion=$(_find_bash_completion "$tree" "$command_name" || true)
	if [[ -n "$completion" ]]; then
		_install_file_atomically "$completion" "$destination" '0644'
	elif _generate_bash_completion "$tool" "$binary" >"$tmp_root/$command_name.bash"; then
		_install_file_atomically "$tmp_root/$command_name.bash" "$destination" '0644'
	elif [[ "$tool" == 'zoxide' ]] && "$gh_bin" api \
		-H 'Accept: application/vnd.github.raw+json' \
		"repos/$repo/contents/contrib/completions/zoxide.bash?ref=$tag" >"$tagged_completion"; then
		# zoxide's binary tarball contains its man pages but not the standalone
		# completion for the zoxide CLI. Fetch the matching file from its tag.
		_install_file_atomically "$tagged_completion" "$destination" '0644'
	else
		_warn "Bash completion is not included or generatable for $tool"
		return 0
	fi

	printf '   bash completion: %s\n' "$destination"
}

_install_helix_runtime() {
	local -r tree="$1"
	local runtime_source=''
	local candidate
	local -r runtime_destination="$XDG_CONFIG_HOME/helix/runtime"
	local runtime_staged
	local runtime_backup=''

	while IFS= read -r -d '' candidate; do
		if [[ -d "$candidate/queries" && -d "$candidate/themes" ]]; then
			runtime_source="$candidate"
			break
		fi
	done < <(find "$tree" -type d -name runtime -print0)

	[[ -n "$runtime_source" ]] || _die 'Helix runtime directory not found in the extracted archive'

	mkdir -p "$(dirname "$runtime_destination")"
	runtime_staged=$(mktemp -d "$(dirname "$runtime_destination")/.runtime.new.XXXXXXXX")
	cp -a "$runtime_source/." "$runtime_staged/"

	# Make the directory replacement effectively atomic on this filesystem.
	# Ignore termination signals only during the two renames, then restore them.
	trap '' HUP INT TERM
	if [[ -e "$runtime_destination" || -L "$runtime_destination" ]]; then
		runtime_backup=$(mktemp -d "$(dirname "$runtime_destination")/.runtime.old.XXXXXXXX")
		rmdir "$runtime_backup"
		mv -- "$runtime_destination" "$runtime_backup"
	fi

	if mv -- "$runtime_staged" "$runtime_destination"; then
		if [[ -n "$runtime_backup" ]]; then
			rm -rf -- "$runtime_backup"
		fi
	else
		if [[ -n "$runtime_backup" && -e "$runtime_backup" ]]; then
			mv -- "$runtime_backup" "$runtime_destination"
		fi
		trap 'exit 130' HUP INT TERM
		_die 'failed to install the Helix runtime'
	fi
	trap 'exit 130' HUP INT TERM

	printf '   Helix runtime: %s\n' "$runtime_destination"
}

# Creates a symbolic link without replacing a regular file. With --force,
# an existing symlink pointing elsewhere is updated, but regular files and
# directories are still preserved.
_safe_ln_s() {
	local -r source="$1"
	local -r destination="$2"
	local current=''

	if [[ ! -e "$source" && ! -L "$source" ]]; then
		_warn "dotfile source does not exist; skipped: $source"
		return 0
	fi

	if [[ -L "$destination" ]]; then
		current=$(readlink "$destination")
		if [[ "$current" == "$source" ]]; then
			return 0
		fi
		if [[ "$force_flag" == 'true' ]]; then
			ln -sfn "$source" "$destination"
			printf '🔗 Updated %s -> %s\n' "$destination" "$source"
		else
			_warn "symlink already points elsewhere; skipped: $destination -> $current"
		fi
		return 0
	fi

	if [[ -e "$destination" ]]; then
		_warn "destination already exists; skipped: $destination"
		return 0
	fi

	mkdir -p "$(dirname "$destination")"
	ln -s "$source" "$destination"
	printf '🔗 Linked %s -> %s\n' "$destination" "$source"
}

# ============================ GitHub CLI ============================

_bootstrap_github_cli() {
	local -r api_url='https://api.github.com/repos/cli/cli/releases/latest'
	local -r release_json="$tmp_root/gh-release.json"
	local -a all_urls=()
	local -a asset_names=()
	local -a asset_urls=()
	local -a checksum_names=()
	local -a checksum_urls=()
	local url name selected_url=''
	local checksum_url=''
	local archive manifest extract_dir
	local i

	printf '\n=== GitHub CLI ===\n'
	printf '🔄 Retrieving the latest release metadata...\n'
	_curl_download "$api_url" "$release_json"

	mapfile -t all_urls < <(
		grep -oE '"browser_download_url"[[:space:]]*:[[:space:]]*"[^"]+"' "$release_json" |
			cut -d '"' -f 4
	)

	for url in "${all_urls[@]}"; do
		name="${url##*/}"
		if [[ "$name" == gh_*_linux_"$gh_arch".tar.gz ]]; then
			asset_names+=("$name")
			asset_urls+=("$url")
		elif [[ "$name" == gh_*_checksums.txt ]]; then
			checksum_names+=("$name")
			checksum_urls+=("$url")
		fi
	done

	_select_candidate 'GitHub CLI' "${asset_names[@]}"
	for ((i = 0; i < ${#asset_names[@]}; ++i)); do
		if [[ "${asset_names[i]}" == "$SELECTED_CANDIDATE" ]]; then
			selected_url="${asset_urls[i]}"
			break
		fi
	done
	[[ -n "$selected_url" ]] || _die 'internal error resolving the GitHub CLI asset URL'

	archive="$tmp_root/$SELECTED_CANDIDATE"
	_curl_download "$selected_url" "$archive"

	if ((${#checksum_names[@]} > 0)); then
		_select_candidate 'GitHub CLI checksum manifest' "${checksum_names[@]}"
		for ((i = 0; i < ${#checksum_names[@]}; ++i)); do
			if [[ "${checksum_names[i]}" == "$SELECTED_CANDIDATE" ]]; then
				checksum_url="${checksum_urls[i]}"
				break
			fi
		done
		manifest="$tmp_root/${checksum_url##*/}"
		_curl_download "$checksum_url" "$manifest"
		_verify_checksum_manifest "$archive" "$manifest"
		rm -f -- "$manifest"
	else
		_warn 'GitHub CLI release has no checksum manifest; continuing without checksum verification'
	fi

	extract_dir="$tmp_root/extract-gh"
	_extract_archive "$archive" "$extract_dir"
	rm -f -- "$archive"

	_install_binary_from_tree "$extract_dir" 'gh'
	gh_bin="$INSTALLED_BINARY"
	_install_man_pages_from_tree "$extract_dir"
	_install_bash_completion 'gh' "$extract_dir" 'gh' "$gh_bin"

	_print_version "$gh_bin"
}

# ========================= GitHub Releases ==========================

# Writes the release tag on line 1, followed by NAME<TAB>DIGEST for all
# release assets. GitHub CLI's embedded jq implementation is used, so jq is
# not a prerequisite.
_fetch_release_metadata() {
	local -r repo="$1"
	local -r output="$2"

	printf '🔄 Retrieving the latest release metadata from %s...\n' "$repo"
	if ! "$gh_bin" api "repos/$repo/releases/latest" \
		--jq '.tag_name, (.assets[] | [.name, (.digest // "")] | @tsv)' >"$output"; then
		_die "failed to retrieve the latest release from $repo"
	fi

	[[ -s "$output" ]] || _die "empty release metadata returned for $repo"
}

_asset_matches_platform() {
	local -r tool="$1"
	local -r name="$2"

	# A glibc host can use either a GNU-linked binary or a statically linked
	# musl binary. A musl host cannot use a glibc-linked binary.
	if [[ "$libc" == 'musl' && "$name" == *-linux-gnu.tar.gz ]]; then
		return 1
	fi

	case "$tool" in
	bat)
		[[ "$name" =~ ^bat-v.+-${arch}-unknown-linux-(gnu|musl)\.tar\.gz$ ]]
		;;
	delta)
		[[ "$name" =~ ^delta-.+-${arch}-unknown-linux-(gnu|musl)\.tar\.gz$ ]]
		;;
	fd)
		[[ "$name" =~ ^fd-v.+-${arch}-unknown-linux-(gnu|musl)\.tar\.gz$ ]]
		;;
	ripgrep)
		[[ "$name" =~ ^ripgrep-.+-${arch}-unknown-linux-(gnu|musl)\.tar\.gz$ ]]
		;;
	helix)
		[[ "$name" =~ ^helix-.+-${arch}-linux\.tar\.(xz|gz)$ ]]
		;;
	zellij)
		[[ "$name" =~ ^zellij(-no-web)?-${arch}-unknown-linux-musl\.tar\.gz$ ]]
		;;
	zoxide)
		[[ "$name" =~ ^zoxide-.+-${arch}-unknown-linux-musl\.tar\.gz$ ]]
		;;
	direnv)
		[[ "$name" == "direnv.linux-$gh_arch" ]]
		;;
	starship)
		[[ "$name" =~ ^starship-${arch}-unknown-linux-(gnu|musl)\.tar\.gz$ ]]
		;;
	shfmt)
		[[ "$name" =~ ^shfmt_v.+_linux_${gh_arch}$ ]]
		;;
	ty)
		[[ "$name" =~ ^ty-${arch}-unknown-linux-(gnu|musl)\.tar\.gz$ ]]
		;;
	ruff)
		[[ "$name" =~ ^ruff-${arch}-unknown-linux-(gnu|musl)\.tar\.gz$ ]]
		;;
	*)
		return 1
		;;
	esac
}

_candidate_assets() {
	local -r tool="$1"
	local -r metadata="$2"
	local name digest

	while IFS=$'\t' read -r name digest; do
		if _asset_matches_platform "$tool" "$name"; then
			printf '%s\n' "$name"
		fi
	done < <(tail -n +2 "$metadata")
}

_asset_digest() {
	local -r metadata="$1"
	local -r asset_name="$2"

	awk -F '\t' -v asset="$asset_name" '$1 == asset { print $2; exit }' "$metadata"
}

_checksum_asset_candidates() {
	local -r metadata="$1"
	local -r asset_name="$2"
	local without_targz="${asset_name%.tar.gz}"
	local without_tarxz="${asset_name%.tar.xz}"
	local name digest
	local -a exact=()
	local -a general=()

	while IFS=$'\t' read -r name digest; do
		case "$name" in
		"$asset_name.sha256" | "$asset_name.sha256sum" | "$without_targz.sha256" | "$without_targz.sha256sum" | "$without_tarxz.sha256" | "$without_tarxz.sha256sum")
			exact+=("$name")
			;;
		*)
			if [[ "${name,,}" =~ (sha256sums?|checksums?) ]]; then
				general+=("$name")
			fi
			;;
		esac
	done < <(tail -n +2 "$metadata")

	if ((${#exact[@]} > 0)); then
		printf '%s\n' "${exact[@]}"
	elif ((${#general[@]} > 0)); then
		printf '%s\n' "${general[@]}"
	fi
}

_download_release_asset() {
	local -r repo="$1"
	local -r tag="$2"
	local -r asset_name="$3"
	local -r destination_dir="$4"

	[[ "$repo" =~ ^[[:alnum:]_.-]+/[[:alnum:]_.-]+$ ]] ||
		_die "invalid GitHub repository name: $repo"

	printf '⏬ Downloading %s\n' "$asset_name"
	"$gh_bin" release download "$tag" \
		--repo="$repo" \
		--pattern "$asset_name" \
		--dir "$destination_dir"

	[[ -f "$destination_dir/$asset_name" ]] || _die "GitHub CLI did not download $asset_name"
}

_verify_release_asset() {
	local -r repo="$1"
	local -r tag="$2"
	local -r metadata="$3"
	local -r asset_name="$4"
	local -r file="$5"
	local digest=''
	local checksum_digest=''
	local manifest
	local -a checksum_assets=()

	digest=$(_asset_digest "$metadata" "$asset_name")
	if [[ "$digest" == sha256:* ]]; then
		_verify_expected_sha256 "$file" "$digest"
		return 0
	elif [[ -n "$digest" ]]; then
		_warn "unsupported release digest '$digest' for $asset_name; looking for a checksum asset"
	fi

	mapfile -t checksum_assets < <(_checksum_asset_candidates "$metadata" "$asset_name")
	if ((${#checksum_assets[@]} == 0)); then
		_warn "no SHA-256 digest or checksum asset is available for $asset_name"
		return 0
	fi

	_select_candidate "$asset_name checksum" "${checksum_assets[@]}"
	manifest="$tmp_root/$SELECTED_CANDIDATE"
	_download_release_asset "$repo" "$tag" "$SELECTED_CANDIDATE" "$tmp_root"

	checksum_digest=$(_asset_digest "$metadata" "$SELECTED_CANDIDATE")
	if [[ "$checksum_digest" == sha256:* ]]; then
		_verify_expected_sha256 "$manifest" "$checksum_digest"
	fi
	_verify_checksum_manifest "$file" "$manifest"
	rm -f -- "$manifest"
}

_configure_tool() {
	local -r tool="$1"

	case "$tool" in
	bat)
		_safe_ln_s "$dotfiles_path/bat/config" "$XDG_CONFIG_HOME/bat/config"
		;;
	fd)
		_safe_ln_s "$dotfiles_path/fd/ignore" "$XDG_CONFIG_HOME/fd/ignore"
		;;
	zellij)
		_safe_ln_s "$dotfiles_path/zellij/config.kdl" "$XDG_CONFIG_HOME/zellij/config.kdl"
		;;
	esac
}

_install_release_tool() {
	local -r tool="$1"
	local repo binary completion_name package_kind='archive'
	local metadata tag asset archive extract_dir
	local -a candidates=()

	case "$tool" in
	bat)
		repo='sharkdp/bat'
		binary='bat'
		completion_name='bat'
		;;
	delta)
		repo='dandavison/delta'
		binary='delta'
		completion_name=''
		;;
	fd)
		repo='sharkdp/fd'
		binary='fd'
		completion_name='fd'
		;;
	ripgrep)
		repo='BurntSushi/ripgrep'
		binary='rg'
		completion_name='rg'
		;;
	helix)
		repo='helix-editor/helix'
		binary='hx'
		completion_name='hx'
		;;
	zellij)
		repo='zellij-org/zellij'
		binary='zellij'
		# The managed .bashrc generates Zellij's Bash completion at startup.
		completion_name=''
		;;
	zoxide)
		repo='ajeetdsouza/zoxide'
		binary='zoxide'
		completion_name='zoxide'
		;;
	direnv)
		repo='direnv/direnv'
		binary='direnv'
		completion_name=''
		package_kind='binary'
		;;
	starship)
		repo='starship/starship'
		binary='starship'
		completion_name='starship'
		;;
	shfmt)
		repo='mvdan/sh'
		binary='shfmt'
		completion_name=''
		package_kind='binary'
		;;
	ty)
		repo='astral-sh/ty'
		binary='ty'
		completion_name=''
		;;
	ruff)
		repo='astral-sh/ruff'
		binary='ruff'
		completion_name=''
		;;
	*)
		_die "internal error: unknown tool '$tool'"
		;;
	esac

	printf '\n=== %s ===\n' "$tool"
	metadata="$tmp_root/release-$tool.tsv"
	_fetch_release_metadata "$repo" "$metadata"
	IFS= read -r tag <"$metadata"
	[[ -n "$tag" ]] || _die "release tag is missing for $repo"

	mapfile -t candidates < <(_candidate_assets "$tool" "$metadata")
	_select_candidate --allow-skip "$tool ($tag)" "${candidates[@]}"
	if [[ "$SELECTION_SKIPPED" == 'true' ]]; then
		printf '⏭️  Skipped %s\n' "$tool"
		return 0
	fi
	asset="$SELECTED_CANDIDATE"
	archive="$tmp_root/$asset"

	_download_release_asset "$repo" "$tag" "$asset" "$tmp_root"
	_verify_release_asset "$repo" "$tag" "$metadata" "$asset" "$archive"

	if [[ "$package_kind" == 'binary' ]]; then
		INSTALLED_BINARY="$install_bin_dir/$binary"
		_install_file_atomically "$archive" "$INSTALLED_BINARY" '0755'
		printf '✅ Installed %s\n' "$INSTALLED_BINARY"
		rm -f -- "$archive"
	else
		extract_dir="$tmp_root/extract-$tool"
		_extract_archive "$archive" "$extract_dir"
		rm -f -- "$archive"

		_install_binary_from_tree "$extract_dir" "$binary"
		_install_man_pages_from_tree "$extract_dir"
		if [[ -n "$completion_name" ]]; then
			_install_bash_completion "$tool" "$extract_dir" "$completion_name" "$INSTALLED_BINARY" "$repo" "$tag"
		fi
	fi

	if [[ "$tool" == 'helix' ]]; then
		_install_helix_runtime "$extract_dir"
	fi

	_configure_tool "$tool"
	_print_version "$INSTALLED_BINARY"
}

# Bear intentionally does not fall back to a distribution package or a source
# build. Either would violate this script's promise to install upstream,
# precompiled release artifacts and could silently introduce ABI dependencies.
_report_bear_release_status() {
	local -r repo='rizsotto/Bear'
	local metadata tag
	local -a uploaded_assets=()

	printf '\n=== bear ===\n'
	metadata="$tmp_root/release-bear.tsv"
	_fetch_release_metadata "$repo" "$metadata"
	IFS= read -r tag <"$metadata"
	[[ -n "$tag" ]] || _die "release tag is missing for $repo"
	mapfile -t uploaded_assets < <(tail -n +2 "$metadata" | awk -F '\t' 'NF && $1 != "" { print $1 }')

	if ((${#uploaded_assets[@]} == 0)); then
		_warn "Bear $tag publishes only GitHub-generated source archives, not precompiled release binaries; skipped"
	else
		_warn "Bear $tag has release assets, but no supported self-contained binary layout is defined; skipped"
	fi
	printf '   Upstream installation currently requires a distribution package or a Rust source build.\n'
}

_ensure_node_runtime() {
	local system_node='' system_npm='' node_major=''
	local index manifest version archive_name archive extract_dir source_dir install_dir

	system_node=$(command -v node || true)
	system_npm=$(command -v npm || true)
	if [[ -n "$system_node" && -n "$system_npm" ]]; then
		node_major=$("$system_node" -p 'process.versions.node.split(".")[0]' 2>/dev/null || true)
		if [[ "$node_major" =~ ^[0-9]+$ ]] && ((node_major >= 20)); then
			NODE_BIN="$system_node"
			NPM_BIN="$system_npm"
			NODE_RUNTIME_BIN_DIR=$(dirname "$NODE_BIN")
			printf '   Using existing Node.js %s\n' "$("$NODE_BIN" --version)"
			return 0
		fi
	fi

	[[ "$libc" == 'gnu' ]] ||
		_die 'automatic Node.js installation is available only on glibc; load Node.js 20+ and npm first'
	_require_command xz

	printf '   Node.js 20+ with npm was not found; installing the latest Node.js LTS runtime.\n'
	index="$tmp_root/node-index.tab"
	_curl_download 'https://nodejs.org/dist/index.tab' "$index"
	version=$(awk -F '\t' -v platform="linux-$node_dist_arch" \
		'NR > 1 && $10 != "-" && index($3, platform) { print $1; exit }' "$index")
	[[ "$version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
		_die 'could not select the latest Node.js LTS release'

	archive_name="node-$version-linux-$node_dist_arch.tar.xz"
	archive="$tmp_root/$archive_name"
	manifest="$tmp_root/SHASUMS256-$version.txt"
	_curl_download "https://nodejs.org/dist/$version/$archive_name" "$archive"
	_curl_download "https://nodejs.org/dist/$version/SHASUMS256.txt" "$manifest"
	_verify_checksum_manifest "$archive" "$manifest"

	extract_dir="$tmp_root/extract-node"
	_extract_archive "$archive" "$extract_dir"
	rm -f -- "$archive" "$manifest" "$index"
	source_dir="$extract_dir/node-$version-linux-$node_dist_arch"
	[[ -x "$source_dir/bin/node" && -x "$source_dir/bin/npm" ]] ||
		_die "the Node.js archive has an unexpected layout: $archive_name"

	install_dir="$XDG_DATA_HOME/deploy_nosudo/node/$version/linux-$node_dist_arch"
	if [[ ! -x "$install_dir/bin/node" || ! -x "$install_dir/bin/npm" ]]; then
		mkdir -p "$install_dir"
		cp -a "$source_dir/." "$install_dir/"
	fi
	NODE_BIN="$install_dir/bin/node"
	NPM_BIN="$install_dir/bin/npm"
	NODE_RUNTIME_BIN_DIR="$install_dir/bin"
	"$NODE_BIN" --version >/dev/null || _die 'the isolated Node.js runtime failed its smoke test'
	PATH="$NODE_RUNTIME_BIN_DIR:$PATH" "$NPM_BIN" --version >/dev/null ||
		_die 'the isolated npm runtime failed its smoke test'
	printf '✅ Installed isolated Node.js %s\n' "$("$NODE_BIN" --version)"
}

_run_npm() {
	[[ -n "$NPM_BIN" && -n "$NODE_RUNTIME_BIN_DIR" ]] || _die 'internal error: Node.js runtime is not initialized'
	PATH="$NODE_RUNTIME_BIN_DIR:$PATH" "$NPM_BIN" "$@"
}

_install_bash_language_server() {
	local -r repo='bash-lsp/bash-language-server'
	local metadata tag version published_version tarball_url integrity archive
	local install_prefix npm_binary entrypoint wrapper

	printf '\n=== bash-language-server ===\n'
	_ensure_node_runtime

	metadata="$tmp_root/release-bash-language-server.tsv"
	_fetch_release_metadata "$repo" "$metadata"
	IFS= read -r tag <"$metadata"
	[[ -n "$tag" ]] || _die "release tag is missing for $repo"
	version="${tag#server-}"
	[[ "$version" != "$tag" && "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]] ||
		_die "unexpected bash-language-server release tag: $tag"

	published_version=$(npm_config_cache="$tmp_root/npm-cache" _run_npm view "bash-language-server@$version" version)
	[[ "$published_version" == "$version" ]] ||
		_die "GitHub release $tag does not match the npm package version ($published_version)"
	tarball_url=$(npm_config_cache="$tmp_root/npm-cache" _run_npm view "bash-language-server@$version" dist.tarball)
	integrity=$(npm_config_cache="$tmp_root/npm-cache" _run_npm view "bash-language-server@$version" dist.integrity)
	[[ "$tarball_url" == https://* ]] || _die "npm returned an invalid tarball URL for bash-language-server $version"
	[[ "$integrity" =~ ^sha(256|384|512)- ]] ||
		_die "npm returned no supported integrity digest for bash-language-server $version"

	archive="$tmp_root/bash-language-server-$version.tgz"
	_curl_download "$tarball_url" "$archive"
	_verify_sri "$archive" "$integrity" "$NODE_BIN"

	# Keep Node package trees separate by architecture/libc. The small launcher
	# itself still lives in the same architecture-aware bin directory as the
	# native tools installed by this script.
	install_prefix="$XDG_DATA_HOME/deploy_nosudo/bash-language-server/$version/${arch}-${libc}"
	printf '📦 Installing bash-language-server %s with npm\n' "$version"
	npm_config_cache="$tmp_root/npm-cache" \
		npm_config_update_notifier='false' \
		_run_npm install --global --prefix "$install_prefix" \
		--no-audit --no-fund --omit=dev --package-lock=false "$archive"
	rm -f -- "$archive"

	npm_binary="$install_prefix/bin/bash-language-server"
	[[ -e "$npm_binary" || -L "$npm_binary" ]] ||
		_die "npm did not install the bash-language-server launcher: $npm_binary"
	entrypoint=$(readlink -f "$npm_binary")
	[[ -f "$entrypoint" ]] || _die "could not resolve the bash-language-server entry point"

	wrapper="$tmp_root/bash-language-server"
	printf '#!/usr/bin/env bash\nexec %q %q "$@"\n' "$NODE_BIN" "$entrypoint" >"$wrapper"
	INSTALLED_BINARY="$install_bin_dir/bash-language-server"
	_install_file_atomically "$wrapper" "$INSTALLED_BINARY" '0755'
	"$INSTALLED_BINARY" --help >/dev/null
	printf '✅ Installed %s (version %s; Node.js %s)\n' "$INSTALLED_BINARY" "$version" "$("$NODE_BIN" --version)"
}

# =========================== Dotfiles setup =========================

make_dirs() {
	mkdir -p "$XDG_CONFIG_HOME"
	mkdir -p "$base_bin_dir"
	mkdir -p "$install_bin_dir"
	mkdir -p "$bash_completion_dir"
	mkdir -p "$man1_dir"
	mkdir -p "$HOME/.cargo/share/man/man1"
	mkdir -p "$HOME/bin"
}

make_symlinks() {
	local -a src_dest_list=(
		'.bash_profile' "$HOME/.bash_profile"
		'.profile' "$HOME/.profile"
		'.bashrc' "$HOME/.bashrc"
		'.bash_aliases' "$HOME/.bash_aliases"
		'.blerc' "$HOME/.blerc"

		'git/config' "$XDG_CONFIG_HOME/git/config"
		'git/ignore' "$XDG_CONFIG_HOME/git/ignore"
		'.vimrc' "$HOME/.vimrc"
		'.nanorc' "$HOME/.nanorc"
		'clangd/config.yaml' "$XDG_CONFIG_HOME/clangd/config.yaml"
		'.clang-format' "$HOME/.clang-format"
		'bear.yml' "$XDG_CONFIG_HOME/bear.yml"
		'pip.conf' "$XDG_CONFIG_HOME/pip/pip.conf"
		'.amrvis.defaults' "$HOME/.amrvis.defaults"
		'gnuplot/gnuplotrc' "$HOME/.gnuplot" # For version >= 6, default config file is ~/.config/gnuplot/gnuplotrc
		'gnuplot/gnuplot-wxt.conf' "$XDG_CONFIG_HOME/gnuplot/gnuplot-wxt.conf"

		'starship.toml' "$XDG_CONFIG_HOME/starship.toml"

		'helix/config.toml' "$XDG_CONFIG_HOME/helix/config.toml"
		'helix/languages.toml' "$XDG_CONFIG_HOME/helix/languages.toml"
		'helix/themes' "$XDG_CONFIG_HOME/helix/themes"
		'.tldrrc' "$HOME/.tldrrc"

		'lazygit/config.yml' "$XDG_CONFIG_HOME/lazygit/config.yml"
	)
	local i source destination

	for ((i = 0; i < ${#src_dest_list[@]}; i += 2)); do
		source="$dotfiles_path/${src_dest_list[i]}"
		destination="${src_dest_list[i + 1]}"
		_safe_ln_s "$source" "$destination"
	done
}

# ======================== Argument processing =======================

help() {
	cat <<EOF
Usage: $self_name [OPTIONS...] [TARGETS...]

Install the latest precompiled GitHub Release binaries without sudo.
For tool deployment, GitHub CLI is installed first. With no TARGETS, all tools
are installed. --symlinks-only bypasses tool installation entirely.

Targets:
  gh, bat, delta, fd, ripgrep (or rg), helix (or hx), zellij, zoxide,
  direnv, starship, bear, shfmt, bash-language-server (or bash-lsp), ty,
  ruff, all

Notes:
  Bear is skipped while upstream provides no precompiled release binary.
  Nerd Fonts are not installed; install and select one in the local terminal.
  bash-language-server is installed from the npm artifact matching the latest
  GitHub Release. Existing Node.js 20+ and npm are reused; otherwise an
  isolated, checksum-verified Node.js LTS runtime is installed automatically.

Options:
  -d, --debug          Print detected platform and temporary-directory information
  -v, --verbose        Enable shell tracing
  -f, --force          Update existing dotfile symlinks that point elsewhere
  -s, --symlinks-only  Run make_symlinks only; do not install any tools
  -V, --version        Show this script's version
  -h, --help           Show this help message
EOF
}

parse_args() {
	while (($# > 0)); do
		case "$1" in
		-d | --debug)
			debug_flag='true'
			;;
		-v | --verbose)
			verbose_flag='true'
			;;
		-f | --force)
			force_flag='true'
			;;
		-s | --symlinks-only)
			symlinks_only_flag='true'
			;;
		-V | --version)
			printf '%s %s\n' "$self_name" "$script_version"
			exit 0
			;;
		-h | --help)
			help
			exit 0
			;;
		--)
			shift
			requested_targets+=("$@")
			break
			;;
		-*)
			_die "unknown option: $1"
			;;
		*)
			requested_targets+=("$1")
			;;
		esac
		shift
	done

	if [[ "$verbose_flag" == 'true' ]]; then
		set -x
	fi
}

_resolve_targets() {
	local -a defaults=(bat delta fd ripgrep helix zellij zoxide direnv starship bear shfmt bash-language-server ty ruff)
	local -A seen=()
	local target normalized

	if ((${#requested_targets[@]} == 0)); then
		requested_targets=(all)
	fi

	for target in "${requested_targets[@]}"; do
		case "$target" in
		all)
			for normalized in "${defaults[@]}"; do
				if [[ -z "${seen[$normalized]:-}" ]]; then
					install_targets+=("$normalized")
					seen[$normalized]=1
				fi
			done
			continue
			;;
		gh)
			# GitHub CLI is always installed as the bootstrap dependency.
			continue
			;;
		rg)
			normalized='ripgrep'
			;;
		hx)
			normalized='helix'
			;;
		bash-lsp | bash-languager-server)
			normalized='bash-language-server'
			;;
		bat | delta | fd | ripgrep | helix | zellij | zoxide | direnv | starship | bear | shfmt | bash-language-server | ty | ruff)
			normalized="$target"
			;;
		*)
			_die "unknown target: $target"
			;;
		esac

		if [[ -z "${seen[$normalized]:-}" ]]; then
			install_targets+=("$normalized")
			seen[$normalized]=1
		fi
	done
}

main() {
	local tool

	parse_args "$@"

	if [[ "$symlinks_only_flag" == 'true' ]]; then
		((${#requested_targets[@]} == 0)) || _die '--symlinks-only does not accept TARGETS'
		make_symlinks
		printf '\n🎉 Symlink setup completed successfully.\n'
		return 0
	fi

	_resolve_targets

	for tool in awk cp curl cut dirname find grep install mktemp mv readlink rmdir sha256sum sort tail tar; do
		_require_command "$tool"
	done

	make_dirs
	_make_temp_dir

	if [[ "$debug_flag" == 'true' ]]; then
		printf 'OS:           %s\n' "$os"
		printf 'ARCH:         %s\n' "$arch"
		printf 'LIBC:         %s\n' "$libc"
		printf 'MACHINE_ARCH: %s\n' "${MACHINE_ARCH:-<native>}"
		printf 'BIN DIR:      %s\n' "$install_bin_dir"
		printf 'TMP DIR:      %s\n' "$tmp_root"
	fi

	_bootstrap_github_cli
	export PATH="$install_bin_dir:$PATH"

	for tool in "${install_targets[@]}"; do
		case "$tool" in
		bear)
			_report_bear_release_status
			;;
		bash-language-server)
			_install_bash_language_server
			;;
		*)
			_install_release_tool "$tool"
			;;
		esac
	done

	make_symlinks

	printf '\n🎉 Deployment completed successfully.\n'
}

(return 0 2>/dev/null) || main "$@"
