#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'
shopt -s inherit_errexit
shopt -s failglob

# ====================================================================
# Precompiled binaries downloader
# Tested *only* on Ubuntu-24.04 LTS on WSL2
# Shell completion and integration are set only for bash
# ====================================================================

# This script's name
readonly self_name="${0##*/}"

# Default values for flags
debug_flag='false'
verbose_flag='false'
force_flag='false'

# For visibility
readonly color_reset='\033[0m'
readonly color_red='\033[31m'
readonly color_yellow='\033[33m'

readonly shell_basename="${SHELL##*/}"

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
readonly bash_completion_dir="$XDG_DATA_HOME/bash-completion/completions"
readonly dotfiles_path="$HOME/dotfiles"

# check OS
_os_raw=$(uname -s)
os="${_os_raw,,}" # to lowercase

# check CPU architecture
# normalize the obtained hardware name to either 'x86_64' or 'aarch64'
_arch_raw=$(uname -m)

case "$_arch_raw" in
x86_64 | amd64)
	readonly arch="x86_64"
	;;
aarch64 | arm64)
	readonly arch="aarch64"
	;;
*)
	echo -e "${color_red}error: unknown architecture ($_arch_raw)${color_reset}" >&2
	exit 1
	;;
esac

# check libc (default: glibc)
# override LIBC only if the output from ldd contains 'musl'
libc="gnu"
if [[ "$os" == "linux" ]]; then
	if ldd --version 2>&1 | grep -iq 'musl'; then
		libc="musl"
	fi
fi

# ========================= Helper functions =========================

_command_exists() {
	command -v "$1" >/dev/null 2>&1
}

# returns 0 (true) is $1 > $2
# Example:
# if _is_version_gt '1.10.0' '1.2.5'; then
# 	echo 'There is an update！'
# fi
_is_version_gt() {
	local v1, v2
	v1=$(echo "$1" | awk -F. '{ printf("%03d%03d%03d\n", $1, $2, $3); }')
	v2=$(echo "$2" | awk -F. '{ printf("%03d%03d%03d\n", $1, $2, $3); }')
	[ "$v1" -gt "$v2" ]
}

# TODO: これは絶対に select で十分
# ==========================================
# Selection menu with arrow keys in pure Bash
# generated by Gemini 3.1 Pro
# ==========================================
_select_with_arrow_keys() {
	local -r options=("$@")
	local key

	selected_index=0 # stores selected index which will be read from outisde of the functions

	tput civis || true # hide cursor
	# ensure the cursor is displayed again when the script ends or when Ctrl+C is pressed
	trap "tput cnorm || true" EXIT SIGINT

	while true; do
		# display candidates
		for i in "${!options[@]}"; do
			if [[ $i -eq $selected_index ]]; then
				echo -e "\e[32m> ${options[$i]}\e[0m" # Highlight the selection in green and put > in front of it
			else
				echo "  ${options[$i]}"
			fi
		done

		# retrieve a single character from the keyboard (for ESC sequence, retrieve subsequent characters)
		read -rsn1 key || true
		if [[ $key == $'\x1b' ]]; then
			read -rsn2 key || true

			if [[ $key == "[A" || $key = 'j' ]]; then # upper arrow ↑ or j
				selected_index=$((selected_index - 1))
				if [[ $selected_index -lt 0 ]]; then
					selected_index=$((${#options[@]} - 1))
				fi
			elif [[ $key == "[B" || $key = 'k' ]]; then # down arrow ↓ or k
				selected_index=$((selected_index + 1))
				if [[ $selected_index -ge ${#options[@]} ]]; then
					selected_index=0
				fi
			fi
		elif [[ $key == "" ]]; then # Enter
			break
		fi

		# move the cursor back up by the number of lines drawn (overlay drawing to prevent screen flickering)
		echo -en "\e[${#options[@]}A"
	done

	# restore the cursor
	tput cnorm || true
	trap - EXIT SIGINT

	return 0
}

_extract_and_copy() {
	local tar_opts=()
	[[ "$verbose_flag" = 'true' ]] && tar_opts+=('--verbose')
	[[ "$force_flag" = 'true' ]] && tar_opts+=('--force')

	local -r targz="$1"
	echo "$targz"

	# TODO: Add mktemp, pushd, popd
	echo "📦 Extracting $targz..."
	# # --strip-components=1 で一番上のディレクトリを剥がして解凍
	# tar -xzf "$targz" --strip-components=1

	# cp bin/gh ~/.local/bin/
}

# Interactive installation helper
ask_and_install() {
	local -r tool_name="$1"
	local -r cmd="$2"
	local -r install_script="$3"

	if eval "_command_exists $cmd"; then
		if eval "_is_latest_${cmd}"; then
			echo "✅ $tool_name is already installed: $(command -v "$cmd")"
		else
			echo 'There are a new version!'
		fi
	else
		read -rp "$tool_name is not installed. Do you want to install it? [Y/n]: " yn
		case "$yn" in
		[Nn]*)
			# skip if $yn starts with N or n
			echo "Skip installing $tool_name."
			;;
		*)
			# run installation otherwise (Enter, Y, y)
			eval "$install_script"
			echo -e "✅ COMPLETE installing $tool_name.\n"
			;;
		esac
	fi
}

